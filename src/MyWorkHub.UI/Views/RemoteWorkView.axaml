<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyWorkHub.UI.ViewModels"
             x:Class="MyWorkHub.UI.Views.RemoteWorkView"
             x:DataType="vm:RemoteWorkViewModel">
    <StackPanel Margin="24" Spacing="8" VerticalAlignment="Top">
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="This section is coming soon." Opacity="0.7" />
    </StackPanel>
</UserControl>
