<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyWorkHub.UI.ViewModels"
             x:Class="MyWorkHub.UI.Views.WorkItemsView"
             x:Name="Root"
             x:DataType="vm:WorkItemsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.wiRow">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Border.wiRow.overdue">
            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource AppNeutralBrush}" />
        </Style>
        <Style Selector="Border.badge.info">
            <Setter Property="Background" Value="{DynamicResource AppInfoBrush}" />
        </Style>
        <Style Selector="Border.badge.success">
            <Setter Property="Background" Value="{DynamicResource AppSuccessBrush}" />
        </Style>
        <Style Selector="Border.badge.danger">
            <Setter Property="Background" Value="{DynamicResource AppDangerBrush}" />
        </Style>
        <Style Selector="Border.badge.neutral">
            <Setter Property="Background" Value="{DynamicResource AppNeutralBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="24">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="↻ Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" />
        </Grid>

        <!-- Body: list (left) + detail panel (right) -->
        <DockPanel Grid.Row="1" LastChildFill="True">

            <!-- Detail panel (docked right, hidden until an item is selected) -->
            <Border DockPanel.Dock="Right"
                    IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Width="360"
                    Margin="12,0,0,0"
                    Background="{DynamicResource AppSurfaceAltBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="6">

                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,10,12,0">
                        <TextBlock Grid.Column="0" Text="{Binding DetailTypeIcon}" FontSize="18"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding DetailTitle}" FontWeight="SemiBold"
                                   FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="✕" VerticalAlignment="Top"
                                Command="{Binding CloseDetailCommand}"
                                Padding="6,2" Margin="6,0,0,0" />
                    </Grid>

                    <!-- Scrollable content -->
                    <ScrollViewer Grid.Row="1" Margin="12,8,12,0">
                        <StackPanel Spacing="12">

                            <TextBlock Text="Loading…" Opacity="0.6" IsVisible="{Binding IsDetailLoading}" />

                            <!-- Read mode -->
                            <StackPanel IsVisible="{Binding !IsEditing}" Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Description" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="{Binding DetailDescription}"
                                               TextWrapping="Wrap" FontSize="13"
                                               IsVisible="{Binding DetailDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="(empty)" Opacity="0.4" FontSize="13"
                                               IsVisible="{Binding DetailDescription, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Acceptance Criteria" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="{Binding DetailAcceptanceCriteria}"
                                               TextWrapping="Wrap" FontSize="13"
                                               IsVisible="{Binding DetailAcceptanceCriteria, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="(empty)" Opacity="0.4" FontSize="13"
                                               IsVisible="{Binding DetailAcceptanceCriteria, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Edit mode -->
                            <StackPanel IsVisible="{Binding IsEditing}" Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Description" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding EditDescription}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="100" MaxHeight="200" FontSize="13" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Acceptance Criteria" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding EditAcceptanceCriteria}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="100" MaxHeight="200" FontSize="13" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Save error -->
                            <TextBlock Text="{Binding SaveError}"
                                       Foreground="{DynamicResource AppDangerBrush}"
                                       TextWrapping="Wrap" FontSize="12"
                                       IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer buttons -->
                    <StackPanel Grid.Row="2" Margin="12,8,12,12" Spacing="8">
                        <Button Content="Edit" Command="{Binding StartEditCommand}"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding !IsEditing}"
                                IsEnabled="{Binding !IsDetailLoading}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                    IsVisible="{Binding IsEditing}">
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                            <Button Content="Save" Command="{Binding SaveChangesCommand}"
                                    IsEnabled="{Binding !IsSaving}" />
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- List (fills remaining space) -->
            <Grid RowDefinitions="Auto,*">

                <!-- @Mentions section -->
                <Border Grid.Row="0"
                        IsVisible="{Binding HasMentions}"
                        Background="{DynamicResource AppSurfaceAltBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12"
                        Margin="0,0,0,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="@ Mentions" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                            <Border IsVisible="{Binding HasNewMentions}"
                                    Background="{DynamicResource AppAccentBrush}"
                                    CornerRadius="8" Padding="6,2">
                                <TextBlock Text="{Binding NewMentionBadge}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Mentions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkItemMentionRow">
                                    <Border Margin="0,0,0,6" CornerRadius="4"
                                            Background="{DynamicResource AppSurfaceBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="0">
                                            <Border Grid.Column="0" IsVisible="{Binding IsNew}"
                                                    Background="{DynamicResource AppAccentBrush}"
                                                    CornerRadius="4,0,0,4" />
                                            <StackPanel Grid.Column="1" Spacing="2" Margin="10,8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding WorkItemTitle}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                    <TextBlock Text="NEW" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource AppAccentBrush}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsNew}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding AuthorDisplayName}" FontSize="12" Opacity="0.8" />
                                                    <TextBlock Text="·" FontSize="12" Opacity="0.5" />
                                                    <TextBlock Text="{Binding When}" FontSize="12" Opacity="0.6" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding TextSnippet}" FontSize="12" Opacity="0.75"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Open" VerticalAlignment="Center" Margin="8"
                                                    Command="{Binding #Root.((vm:WorkItemsViewModel)DataContext).OpenMentionCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Main work items content -->
                <Panel Grid.Row="1">

                    <Border IsVisible="{Binding NeedsConfiguration}"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AppSurfaceAltBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding ConfigurationMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Settings → Integrations → Azure DevOps: paste a Personal Access Token and add your team project name(s)."
                                       Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AppSurfaceAltBrush}"
                            BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Loading…" Opacity="0.7" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" />

                    <TextBlock Text="No work items assigned to you in the current sprint." Opacity="0.7"
                               IsVisible="{Binding IsEmpty}" VerticalAlignment="Top" />

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkItemGroup">
                                    <StackPanel Spacing="6" Margin="0,0,0,16">
                                        <TextBlock FontSize="16" FontWeight="SemiBold">
                                            <Run Text="{Binding Name}" />
                                            <Run Text="(" />
                                            <Run Text="{Binding Count}" />
                                            <Run Text=")" />
                                        </TextBlock>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WorkItemRow">
                                                    <Border Classes="wiRow card" Classes.overdue="{Binding IsOverdue}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                                            <TextBlock Grid.Column="0" Text="{Binding TypeIcon}" FontSize="18" VerticalAlignment="Center"
                                                                       ToolTip.Tip="{Binding Type}" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Border Classes="badge"
                                                                            Classes.info="{Binding IsBadgeInfo}"
                                                                            Classes.success="{Binding IsBadgeSuccess}"
                                                                            Classes.danger="{Binding IsBadgeDanger}"
                                                                            Classes.neutral="{Binding IsBadgeNeutral}"
                                                                            CornerRadius="8" Padding="8,2">
                                                                        <TextBlock Text="{Binding State}" Foreground="White" FontSize="11" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding DueText}" FontSize="12" Opacity="0.7"
                                                                               IsVisible="{Binding DueText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" MinWidth="70">
                                                                <TextBlock Text="Priority / Effort" FontSize="10" Opacity="0.6" />
                                                                <TextBlock FontSize="12">
                                                                    <Run Text="P" /><Run Text="{Binding Priority}" />
                                                                    <Run Text="  ·  " />
                                                                    <Run Text="{Binding Effort}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" VerticalAlignment="Center"
                                                                    Content="Details"
                                                                    Command="{Binding #Root.((vm:WorkItemsViewModel)DataContext).ShowDetailsCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Grid.Column="4" VerticalAlignment="Center"
                                                                    Content="Open in AzDO"
                                                                    Command="{Binding #Root.((vm:WorkItemsViewModel)DataContext).OpenCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </Panel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
