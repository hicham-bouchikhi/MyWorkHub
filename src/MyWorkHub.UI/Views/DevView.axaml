<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyWorkHub.UI.ViewModels"
             xmlns:controls="using:MyWorkHub.UI.Controls"
             x:Class="MyWorkHub.UI.Views.DevView"
             x:DataType="vm:DevViewModel">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Padding="20,16,20,8">
            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Component showcase — MarkdownEditorControl"
                           FontSize="11" Opacity="0.45" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <controls:MarkdownEditorControl Grid.Row="1" />

    </Grid>

</UserControl>
