<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyWorkHub.Presentation.Features.Email"
             xmlns:behaviors="using:MyWorkHub.UI.Behaviors"
             xmlns:graph="using:MyWorkHub.UI.Features.GraphAuth"
             x:Class="MyWorkHub.UI.Features.Email.EmailView"
             x:DataType="vm:EmailViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.unread">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Summarize"
                        ToolTip.Tip="AI digest of the loaded emails (Claude CLI)"
                        Command="{Binding SummarizeCommand}"
                        IsVisible="{Binding IsSummaryAvailable}" />
                <Button Content="Stop"
                        Command="{Binding SummarizeCancelCommand}"
                        IsVisible="{Binding SummarizeCommand.IsRunning}" />
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        IsVisible="{Binding IsAvailable}" />
            </StackPanel>
        </Grid>

        <graph:GraphPageStatus Grid.Row="1" Margin="0,0,0,12" />

        <!-- AI digest: progress while running, then the result (or why it failed). -->
        <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        IsVisible="{Binding SummaryStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ProgressBar IsIndeterminate="True"
                             Width="80"
                             IsVisible="{Binding SummarizeCommand.IsRunning}" />
                <TextBlock Text="{Binding SummaryStatus}"
                           Foreground="{DynamicResource AppTextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Text="{Binding SummaryError}"
                       Foreground="{DynamicResource AppDangerBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding SummaryError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Border Classes="card"
                    Padding="16"
                    MaxHeight="260"
                    IsVisible="{Binding SummaryText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- List on the left, reading pane on the right. -->
        <Grid Grid.Row="3" ColumnDefinitions="2*,3*" ColumnSpacing="16">

            <!-- A real ListBox (selection + ScrollIntoView), not a bare ItemsControl, so deep links
                 can land on a row. It scrolls itself: do not wrap it in a ScrollViewer. -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     behaviors:ScrollIntoViewBehavior.Item="{Binding HighlightedItem}"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EmailRowViewModel">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding From}"
                                           Classes.unread="{Binding IsUnread}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ReceivedAtText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <TextBlock Grid.Column="0"
                                           Text="⚑"
                                           Foreground="{DynamicResource AppDangerBrush}"
                                           IsVisible="{Binding IsFlagged}"
                                           ToolTip.Tip="Flagged" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Subject}"
                                           Classes.unread="{Binding IsUnread}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock Text="{Binding Preview}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FolderName}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1"
                    Classes="card"
                    Padding="16"
                    IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="{Binding SelectedItem.Subject, FallbackValue=''}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding SelectedItem.From, FallbackValue=''}"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               Margin="0,4,0,12" />
                    <Panel Grid.Row="2">
                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsBodyLoading}"
                                     VerticalAlignment="Top" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock Text="{Binding SelectedBody}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Panel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
