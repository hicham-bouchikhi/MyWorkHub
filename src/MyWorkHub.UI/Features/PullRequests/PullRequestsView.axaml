<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyWorkHub.Presentation.Features.PullRequests"
             xmlns:behaviors="using:MyWorkHub.UI.Behaviors"
             xmlns:azdo="using:MyWorkHub.UI.Features.AzureDevOps"
             x:Class="MyWorkHub.UI.Features.PullRequests.PullRequestsView"
             x:Name="Root"
             x:DataType="vm:PullRequestsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    IsVisible="{Binding IsAvailable}"
                    VerticalAlignment="Center" />
        </Grid>

        <azdo:AzureDevOpsPageStatus Grid.Row="1" Margin="0,0,0,12" />

        <!-- A real ListBox (selection + ScrollIntoView), not a bare ItemsControl, so deep links
             can land on a row. It scrolls itself: do not wrap it in a ScrollViewer. -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem}"
                 behaviors:ScrollIntoViewBehavior.Item="{Binding HighlightedItem}"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PullRequestRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding IdText}"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="Draft"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                           IsVisible="{Binding IsDraft}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock Text="{Binding RepositoryText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding BranchesText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding RoleText}" FontSize="12" />
                                <TextBlock Text="{Binding Author}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                                <TextBlock Text="{Binding CreatedAtText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                                <TextBlock Text="{Binding VoteText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppAccentBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Review"
                                    ToolTip.Tip="AI code review (Claude CLI)"
                                    IsVisible="{Binding #Root.((vm:PullRequestsViewModel)DataContext).IsReviewAvailable}"
                                    Command="{Binding #Root.((vm:PullRequestsViewModel)DataContext).ReviewCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Review with…"
                                    ToolTip.Tip="AI code review with a review-agent file chosen for this review only"
                                    IsVisible="{Binding #Root.((vm:PullRequestsViewModel)DataContext).CanPickReviewAgent}"
                                    Command="{Binding #Root.((vm:PullRequestsViewModel)DataContext).ReviewWithAgentCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Open"
                                    ToolTip.Tip="Open in Azure DevOps"
                                    Command="{Binding #Root.((vm:PullRequestsViewModel)DataContext).OpenCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Running / last AI review: streaming progress, then the Markdown report. -->
        <Border Grid.Row="3"
                Classes="card"
                Padding="16"
                Margin="0,12,0,0"
                MaxHeight="320"
                IsVisible="{Binding ReviewedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               Text="{Binding ReviewedItem.IdText, FallbackValue=''}"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ReviewedItem.Title, FallbackValue=''}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2"
                            Content="Stop"
                            Command="{Binding CancelReviewCommand}"
                            IsVisible="{Binding IsReviewing}" />
                </Grid>
                <StackPanel Grid.Row="1" Spacing="4" Margin="0,6,0,6">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsReviewing}" />
                    <TextBlock Text="{Binding ReviewError}"
                               Foreground="{DynamicResource AppDangerBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ReviewError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock Text="{Binding ReviewOutput}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
