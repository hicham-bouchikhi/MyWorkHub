<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\Publish\win-x64\</PublishDir>

    <!-- Bundle everything (runtime + app) into one exe. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!--
      Native libraries (e.g. Avalonia skia renderer, e_sqlite3) cannot be
      embedded inside the PE on Windows — they are extracted to a temp folder on
      first run and cached there for subsequent launches.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Ahead-of-time native compilation is intentionally disabled (EF Core / Graph /
         MSAL / Playwright / Quartz are all reflection-based — see Directory.Build.props). -->
    <PublishAot>false</PublishAot>

    <!-- ReadyToRun improves cold-start time without requiring AOT. -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
